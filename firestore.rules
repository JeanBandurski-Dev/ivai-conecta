rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Architecture: Ivaí Conecta
    // ===============================================================
    //
    // Collection: users/{userId}
    //   - id, uid: string (identificador igual a auth.uid)
    //   - name: string (2 a 120 caracteres)
    //   - email: string
    //   - role: string (aluno, empresa, professor, freelancer, admin, candidato)
    //   - isVerifiedStudent: bool (apenas confirmado se email_verified via Firebase Auth)
    //   - isVerifiedCompany: bool
    //   - status, blocked: string / bool (controlados exclusivamente pelo Admin)
    //
    // Collection: jobs/{jobId}
    //   - title: string (min 3 chars)
    //   - company: string (min 2 chars)
    //   - createdBy: string (igual a auth.uid)
    //   - applicantsCount: number (inicia em 0; incrementos/decrementos atômicos protegidos)
    //   - status: string (Ativa, Pendente, Encerrada, Rejeitada)
    //
    // Collection: applications/{applicationId}
    //   - candidateUid: string (igual a auth.uid do candidato)
    //   - recruiterUid: string (recrutador dono da vaga)
    //   - jobId: string
    //   - status, stage: controlados pelo recrutador (candidato não pode se auto-aprovar)
    //
    // Collection: services/{serviceId}
    //   - title: string (min 3 chars)
    //   - createdBy / providerUid: string (igual a auth.uid do prestador)
    //   - rating: number (0 a 5; prestador não pode alterar diretamente a própria nota)
    //   - reviewsCount: number (inicia em 0)
    //
    // Collection: endorsement_requests/{requestId}
    //   - studentId: string (aluno solicitante)
    //   - profEmail: string (docente avaliador)
    //   - status: string (Pendente, Aprovado, Recusado; aluno não pode se auto-recomendar)
    //
    // Collection: service_orders/{orderId}
    //   - clientUid: string (cliente solicitante)
    //   - providerUid: string (prestador do serviço)
    //   - status: string
    //
    // Collection: favorites/{favoriteId}
    //   - userUid: string (proprietário do favorito)
    //
    // Collection: chats/{chatId} & subcollection messages/{messageId}
    //   - participants / participantUids: array (apenas membros autorizados)
    //
    // ===============================================================

    // --- FUNÇÕES AUXILIARES DE AUTORIZAÇÃO E INTEGRIDADE ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'admin@ivaiconecta.com.br'
      );
    }

    // -------------------------------------------------------------
    // 1. Coleção USERS (Perfis de Usuários)
    // Leitura: Pública para visualização de perfis e diretórios.
    // Criação: Próprio usuário logado (isOwner).
    //   - Proibida auto-promoção a 'admin'.
    //   - Proibido criar perfil pré-bloqueado.
    //   - Proibido forjar selo 'isVerifiedStudent' sem e-mail verificado no Firebase Auth.
    // Atualização:
    //   - Admin pode atualizar qualquer campo.
    //   - Usuário dono: NÃO pode alterar 'role', 'status', 'blocked' ou 'blockedReason'.
    //   - Aluno só pode ativar 'isVerifiedStudent' se o token de e-mail estiver verificado.
    // Deleção: Usuário dono ou Admin.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;

      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin()) &&
        (!('blocked' in request.resource.data) || request.resource.data.blocked == false) &&
        (!('status' in request.resource.data) || request.resource.data.status != 'blocked') &&
        (!('isVerifiedStudent' in request.resource.data) || request.resource.data.isVerifiedStudent == false || request.auth.token.email_verified == true || isAdmin());

      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'blocked', 'blockedReason']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerifiedStudent']) ||
          request.resource.data.isVerifiedStudent == resource.data.isVerifiedStudent ||
          request.auth.token.email_verified == true
        )
      );

      allow delete: if isAdmin() || isOwner(userId);
    }

    // -------------------------------------------------------------
    // 2. Coleção JOBS (Vagas de Emprego)
    // Leitura: Pública.
    // Criação: Empresa, recrutador autenticado ou Admin.
    //   - createdBy deve bater com request.auth.uid.
    //   - Título e empresa com tamanho mínimo exigido.
    //   - applicantsCount inicial não pode ser forjado (inicia em 0 ou ausente).
    // Atualização:
    //   - Admin pode atualizar tudo.
    //   - Recrutador/Criador pode atualizar detalhes da vaga (createdBy é imutável).
    //   - Candidato aplicando/desistindo só pode alterar applicantsCount de forma atômica (+1 ou -1).
    // Exclusão: Recrutador criador ou Admin.
    // -------------------------------------------------------------
    match /jobs/{jobId} {
      allow read: if true;

      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.createdBy == request.auth.uid &&
          (!('recruiterEmail' in request.resource.data) || request.resource.data.recruiterEmail == request.auth.token.email) &&
          request.resource.data.title is string && request.resource.data.title.size() >= 3 &&
          request.resource.data.company is string && request.resource.data.company.size() >= 2 &&
          (!('applicantsCount' in request.resource.data) || request.resource.data.applicantsCount == 0)
        )
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.createdBy == request.auth.uid || resource.data.recruiterEmail == request.auth.token.email) &&
          request.resource.data.createdBy == resource.data.createdBy
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount', 'updatedAt']) &&
          (
            request.resource.data.applicantsCount == resource.data.applicantsCount + 1 ||
            (resource.data.applicantsCount > 0 && request.resource.data.applicantsCount == resource.data.applicantsCount - 1)
          )
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 3. Coleção APPLICATIONS (Candidaturas e Processo Seletivo)
    // Leitura: Candidato proprietário, Recrutador da vaga ou Admin.
    // Criação: Próprio candidato.
    //   - Proibido criar já com status 'Aprovado' ou 'Admitido'.
    // Atualização:
    //   - Admin: total.
    //   - Recrutador: pode gerenciar etapas (stage), status e pareceres (candidateUid e jobId imutáveis).
    //   - Candidato: NÃO PODE alterar etapas ou se auto-aprovar. Só pode desistir/cancelar ou atualizar notas.
    // Exclusão: Candidato, Recrutador ou Admin.
    // -------------------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.candidateUid == request.auth.uid ||
        resource.data.candidateEmail == request.auth.token.email ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );

      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          (request.resource.data.candidateUid == request.auth.uid || request.resource.data.candidateEmail == request.auth.token.email) &&
          request.resource.data.candidateUid == request.auth.uid &&
          (!('status' in request.resource.data) || request.resource.data.status in ['Pendente', 'Enviada', 'Candidatura Enviada', 'Em Análise', 'Triagem de Currículo'])
        )
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.recruiterUid == request.auth.uid || resource.data.recruiterEmail == request.auth.token.email) &&
          request.resource.data.candidateUid == resource.data.candidateUid &&
          request.resource.data.jobId == resource.data.jobId
        ) ||
        (
          (resource.data.candidateUid == request.auth.uid || resource.data.candidateEmail == request.auth.token.email) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'updatedAt', 'notes', 'coverLetter']) &&
          (
            request.resource.data.status == resource.data.status ||
            request.resource.data.status in ['Cancelada', 'Desistente', 'Pendente']
          )
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.candidateUid == request.auth.uid ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 4. Coleção SERVICES (Marketplace de Serviços Autônomos)
    // Leitura: Pública.
    // Criação: Prestador autenticado ou Admin.
    //   - Proibido criar serviço com avaliação forjada (rating inicial deve ser 0/nulo).
    // Atualização:
    //   - Admin: total.
    //   - Prestador: pode editar dados do serviço, mas NÃO PODE alterar a própria nota (rating) nem reviewsCount.
    //   - Clientes/Visitantes: podem registrar avaliações, fórum e métricas de visualização (rating limitado entre 0 e 5).
    // Exclusão: Prestador criador ou Admin.
    // -------------------------------------------------------------
    match /services/{serviceId} {
      allow read: if true;

      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          (request.resource.data.createdBy == request.auth.uid ||
           request.resource.data.providerUid == request.auth.uid ||
           request.resource.data.providerEmail == request.auth.token.email) &&
          request.resource.data.title is string && request.resource.data.title.size() >= 3 &&
          (!('rating' in request.resource.data) || request.resource.data.rating == 0 || request.resource.data.rating == null) &&
          (!('reviewsCount' in request.resource.data) || request.resource.data.reviewsCount == 0 || request.resource.data.reviewsCount == null)
        )
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.createdBy == request.auth.uid ||
           resource.data.providerUid == request.auth.uid ||
           resource.data.providerEmail == request.auth.token.email) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'reviewsCount', 'reviewCount'])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['analytics', 'rating', 'reviewsCount', 'reviewCount', 'reviews', 'forumTopics', 'updatedAt']) &&
          (!('rating' in request.resource.data) || (
            (request.resource.data.rating is int || request.resource.data.rating is float || request.resource.data.rating is number) &&
            request.resource.data.rating >= 0 &&
            request.resource.data.rating <= 5
          ))
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 5. Coleção ENDORSEMENT_REQUESTS (Recomendações e Pareceres Docentes)
    // Leitura: Aluno solicitante, Professor avaliador ou Admin.
    // Criação: Aluno logado (status deve ser 'Pendente'; não pode se auto-recomendar).
    // Atualização:
    //   - Admin: total.
    //   - Professor: pode redigir parecer (quote), aprovar ou recusar.
    //   - Aluno: NÃO PODE aprovar o próprio parecer. Pode apenas cancelar enquanto pendente.
    // Exclusão: Aluno, Professor ou Admin.
    // -------------------------------------------------------------
    match /endorsement_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.profEmail == request.auth.token.email
      );
      
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.studentId == request.auth.uid &&
          (!('status' in request.resource.data) || request.resource.data.status == 'Pendente')
        )
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.profEmail == request.auth.token.email &&
          request.resource.data.studentId == resource.data.studentId
        ) ||
        (
          resource.data.studentId == request.auth.uid &&
          resource.data.status == 'Pendente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'notes']) &&
          request.resource.data.status != 'Aprovado'
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.studentId == request.auth.uid ||
        resource.data.profEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 6. Coleção FAVORITES (Favoritos de Vagas e Talentos)
    // Cada usuário só acessa seus próprios favoritos salvos.
    // -------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read, delete: if isAuthenticated() && resource.data.userUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userUid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // 7. Coleção CHATS & Subcoleção MESSAGES
    // Apenas os participantes da conversa (por e-mail ou UID) têm acesso à thread e às mensagens.
    // Remetente de mensagens é estritamente validado com o usuário autenticado.
    // -------------------------------------------------------------
    match /chats/{chatId} {
      allow get: if isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email in resource.data.participants ||
          request.auth.token.email.lower() in resource.data.participants
        )) ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids)
      );
      
      allow list: if isAuthenticated();

      allow create: if isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email in request.resource.data.participants ||
          request.auth.token.email.lower() in request.resource.data.participants
        )) ||
        (request.resource.data.participantUids != null && request.auth.uid in request.resource.data.participantUids)
      );

      allow update, delete: if isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email in resource.data.participants ||
          request.auth.token.email.lower() in resource.data.participants
        )) ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids)
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          (request.auth.token.email != null && (
            request.auth.token.email in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids != null &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids)
        );

        allow create: if isAuthenticated() && (
          (request.auth.token.email != null && (
            request.auth.token.email in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids != null &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids)
        ) && (
          request.resource.data.senderEmail == request.auth.token.email ||
          request.resource.data.senderEmail == request.auth.token.email.lower() ||
          request.resource.data.senderId == request.auth.uid
        );

        allow update, delete: if isAuthenticated() && (
          resource.data.senderEmail == request.auth.token.email ||
          resource.data.senderEmail == request.auth.token.email.lower() ||
          resource.data.senderId == request.auth.uid
        );
      }
    }

    // -------------------------------------------------------------
    // 8. Coleção SERVICE_ORDERS (Pedidos e Demandas de Serviços)
    // Apenas cliente, prestador ou Admin podem acessar e gerenciar.
    // -------------------------------------------------------------
    match /service_orders/{orderId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        resource.data.clientEmail == request.auth.token.email ||
        resource.data.providerUid == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email
      );

      allow create: if isAuthenticated() && (
        request.resource.data.clientUid == request.auth.uid ||
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.clientEmail == request.auth.token.email
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          (resource.data.clientUid == request.auth.uid || resource.data.clientId == request.auth.uid || resource.data.clientEmail == request.auth.token.email ||
           resource.data.providerUid == request.auth.uid || resource.data.providerId == request.auth.uid || resource.data.providerEmail == request.auth.token.email) &&
          (!('clientUid' in resource.data) || request.resource.data.clientUid == resource.data.clientUid) &&
          (!('providerUid' in resource.data) || request.resource.data.providerUid == resource.data.providerUid)
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
    }

    // -------------------------------------------------------------
    // 9. Compatibilidade Legada (Coleções talents e teachers)
    // -------------------------------------------------------------
    match /talents/{talentId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == talentId;
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == teacherId;
    }
  }
}
