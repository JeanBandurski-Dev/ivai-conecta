rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNÇÕES AUXILIARES DE AUTORIZAÇÃO ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------
    // 1. Coleção USERS
    // Leitura pública de perfis (para visualização de talentos/profissionais/empresas).
    // Criação, alteração e deleção permitidas APENAS para o próprio usuário autenticado.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    // -------------------------------------------------------------
    // 2. Coleção JOBS (Vagas de Emprego)
    // Leitura pública (qualquer um pode visualizar as vagas no mural).
    // Criação: Usuário autenticado vinculado ao createdBy ou recruiterEmail.
    // Edição: Apenas a empresa dona da vaga, OU qualquer candidato autenticado
    // que esteja APENAS incrementando/decrementando o contador 'applicantsCount'.
    // Exclusão: Apenas a empresa dona da vaga.
    // -------------------------------------------------------------
    match /jobs/{jobId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.recruiterEmail == request.auth.token.email
      );
      
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount'])
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 3. Coleção APPLICATIONS (Candidaturas)
    // Leitura: Apenas o próprio candidato OU o recrutador da vaga.
    // Criação: Apenas o candidato para si mesmo.
    // Atualização: Candidato (desistência) ou Recrutador (avanço de etapas no funil).
    // Exclusão: Candidato ou Recrutador.
    // -------------------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.candidateUid == request.auth.uid ||
        resource.data.candidateEmail == request.auth.token.email ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );

      allow create: if isAuthenticated() && (
        request.resource.data.candidateUid == request.auth.uid ||
        request.resource.data.candidateEmail == request.auth.token.email
      );

      allow update: if isAuthenticated() && (
        resource.data.candidateUid == request.auth.uid ||
        resource.data.candidateEmail == request.auth.token.email ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );

      allow delete: if isAuthenticated() && (
        resource.data.candidateUid == request.auth.uid ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 4. Coleção SERVICES (Marketplace de Serviços Autônomos)
    // Leitura pública.
    // Criação: Prestador autenticado.
    // Edição: Prestador proprietário, OU qualquer usuário atualizando o 'analytics' (cliques no WhatsApp).
    // Exclusão: Apenas o prestador proprietário.
    // -------------------------------------------------------------
    match /services/{serviceId} {
      allow read: if true;

      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.providerEmail == request.auth.token.email
      );

      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['analytics'])
      );

      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 5. Coleção ENDORSEMENT_REQUESTS (Pareceres e Recomendações)
    // Alunos solicitam pareceres e professores avaliam.
    // -------------------------------------------------------------
    match /endorsement_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.profEmail == request.auth.token.email
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid
      );
      
      allow update, delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.profEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 6. Coleção FAVORITES (Favoritos de Vagas e Talentos)
    // Cada usuário só acessa seus próprios favoritos salvos.
    // -------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read, delete: if isAuthenticated() && resource.data.userUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userUid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // 7. Coleção CHATS & Subcoleção MESSAGES
    // Apenas os participantes da conversa têm acesso à thread e às mensagens.
    // -------------------------------------------------------------
    match /chats/{chatId} {
      allow get: if isAuthenticated() && (
        request.auth.token.email in resource.data.participants
      );
      
      allow list: if isAuthenticated();

      allow create: if isAuthenticated() && (
        request.auth.token.email in request.resource.data.participants
      );

      allow update, delete: if isAuthenticated() && (
        request.auth.token.email in resource.data.participants
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.token.email in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );

        allow create: if isAuthenticated() && (
          request.auth.token.email in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        ) && (
          request.resource.data.senderEmail == request.auth.token.email ||
          request.resource.data.senderId == request.auth.uid
        );

        allow update, delete: if isAuthenticated() && (
          resource.data.senderEmail == request.auth.token.email ||
          resource.data.senderId == request.auth.uid
        );
      }
    }

    // Compatibilidade legada para coleções talents e teachers
    match /talents/{talentId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == talentId;
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == teacherId;
    }

    // Coleção de Verificação de E-mail (códigos OTP)
    match /email_verifications/{verifId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == verifId ||
        request.resource.data.email == request.auth.token.email ||
        resource.data.email == request.auth.token.email
      );
    }
  }
}
