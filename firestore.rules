rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNÇÕES AUXILIARES DE AUTORIZAÇÃO ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'admin@ivaiconecta.com.br'
      );
    }

    // -------------------------------------------------------------
    // 1. Coleção USERS
    // Leitura pública de perfis (para visualização de talentos/profissionais/empresas).
    // Criação: Usuário autenticado para o próprio id, sem auto-promoção para 'admin'.
    // Atualização: Admin pode alterar qualquer usuário (inclusive role/status/bloqueio).
    // Usuário comum só atualiza seu próprio perfil SE não tentar alterar 'role', 'status' ou 'blocked'.
    // Deleção: Permitida ao próprio usuário ou ao admin.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow update: if isAdmin() || (
        isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'blocked'])
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // -------------------------------------------------------------
    // 2. Coleção JOBS (Vagas de Emprego)
    // Leitura pública (qualquer um pode visualizar as vagas no mural).
    // Criação: Empresa/recrutador autenticado ou Admin.
    // Edição: Empresa dona da vaga, Admin, OU candidato atualizando applicantsCount.
    // Exclusão: Empresa dona da vaga ou Admin.
    // -------------------------------------------------------------
    match /jobs/{jobId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.recruiterEmail == request.auth.token.email
      );
      
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicantsCount'])
      );
      
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 3. Coleção APPLICATIONS (Candidaturas)
    // Leitura: Próprio candidato, recrutador da vaga OU Admin para auditoria.
    // Criação: Candidato para si mesmo.
    // Atualização: Candidato, Recrutador ou Admin.
    // Exclusão: Candidato, Recrutador ou Admin.
    // -------------------------------------------------------------
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.candidateUid == request.auth.uid ||
        resource.data.candidateEmail == request.auth.token.email ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );

      allow create: if isAuthenticated() && (
        request.resource.data.candidateUid == request.auth.uid ||
        request.resource.data.candidateEmail == request.auth.token.email
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.candidateUid == request.auth.uid ||
        resource.data.candidateEmail == request.auth.token.email ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.candidateUid == request.auth.uid ||
        resource.data.recruiterUid == request.auth.uid ||
        resource.data.recruiterEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 4. Coleção SERVICES (Marketplace de Serviços Autônomos)
    // Leitura pública.
    // Criação: Prestador autenticado ou Admin.
    // Edição: Prestador proprietário, Admin, OU qualquer usuário atualizando analytics.
    // Exclusão: Prestador proprietário ou Admin.
    // -------------------------------------------------------------
    match /services/{serviceId} {
      allow read: if true;

      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.createdBy == request.auth.uid ||
        request.resource.data.providerEmail == request.auth.token.email
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['analytics'])
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 5. Coleção ENDORSEMENT_REQUESTS (Pareceres e Recomendações)
    // Alunos solicitam pareceres e professores avaliam.
    // -------------------------------------------------------------
    match /endorsement_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.profEmail == request.auth.token.email
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid
      );
      
      allow update, delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.profEmail == request.auth.token.email
      );
    }

    // -------------------------------------------------------------
    // 6. Coleção FAVORITES (Favoritos de Vagas e Talentos)
    // Cada usuário só acessa seus próprios favoritos salvos.
    // -------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read, delete: if isAuthenticated() && resource.data.userUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userUid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // 7. Coleção CHATS & Subcoleção MESSAGES
    // Apenas os participantes da conversa têm acesso à thread e às mensagens.
    // -------------------------------------------------------------
    match /chats/{chatId} {
      allow get: if isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email in resource.data.participants ||
          request.auth.token.email.lower() in resource.data.participants
        )) ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids)
      );
      
      allow list: if isAuthenticated();

      allow create: if isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email in request.resource.data.participants ||
          request.auth.token.email.lower() in request.resource.data.participants
        )) ||
        (request.resource.data.participantUids != null && request.auth.uid in request.resource.data.participantUids)
      );

      allow update, delete: if isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email in resource.data.participants ||
          request.auth.token.email.lower() in resource.data.participants
        )) ||
        (resource.data.participantUids != null && request.auth.uid in resource.data.participantUids)
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          (request.auth.token.email != null && (
            request.auth.token.email in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids != null &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids)
        );

        allow create: if isAuthenticated() && (
          (request.auth.token.email != null && (
            request.auth.token.email in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          )) ||
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids != null &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids)
        ) && (
          request.resource.data.senderEmail == request.auth.token.email ||
          request.resource.data.senderEmail == request.auth.token.email.lower() ||
          request.resource.data.senderId == request.auth.uid
        );

        allow update, delete: if isAuthenticated() && (
          resource.data.senderEmail == request.auth.token.email ||
          resource.data.senderEmail == request.auth.token.email.lower() ||
          resource.data.senderId == request.auth.uid
        );
      }
    }

    // Compatibilidade legada para coleções talents e teachers
    match /talents/{talentId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == talentId;
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == teacherId;
    }

    // Service Orders Collection (Pedidos e Demandas de Serviços)
    match /service_orders/{orderId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.clientEmail == request.auth.token.email ||
        resource.data.providerUid == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email
      );

      allow create: if isAuthenticated() && (
        request.resource.data.clientUid == request.auth.uid ||
        request.resource.data.clientEmail == request.auth.token.email
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientUid == request.auth.uid ||
        resource.data.clientEmail == request.auth.token.email ||
        resource.data.providerUid == request.auth.uid ||
        resource.data.providerEmail == request.auth.token.email
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientUid == request.auth.uid
      );
    }
  }
}
