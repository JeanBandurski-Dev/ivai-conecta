rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regra para a pasta do usuário: cada usuário só pode escrever e deletar dentro da sua própria pasta
    match /users/{userId}/{allPaths=**} {
      // Leitura pública (necessário para exibir fotos de perfil e logotipos nos murais)
      allow read: if true;

      // Escrita restrita ao usuário dono da pasta (limite de 10MB por arquivo)
      allow write: if request.auth != null 
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;

      // Exclusão permitida apenas ao dono dos arquivos
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueia qualquer tentativa de escrita fora das pastas autorizadas
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
