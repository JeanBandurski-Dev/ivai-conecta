rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir leitura pública dos avatares e imagens
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Regra geral para upload de documentos autenticados
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
