rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.admin == true;
    }

    // Fotos de perfil, logotipos e imagens de capa usados publicamente em perfis e murais.
    match /users/{userId}/{fileName} {
      allow read: if fileName.matches('^(avatar|cover|banner)_.*');

      allow write: if isOwner(userId)
        && fileName.matches('^(avatar|cover|banner)_.*')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/jpg',
          'image/png',
          'image/webp',
          'image/gif'
        ];

      allow delete: if isOwner(userId) || isAdmin();
    }

    // Currículos, comprovantes estudantis e documentos empresariais.
    // Somente o proprietário ou um administrador podem ler ou excluir.
    match /users/{userId}/docs/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();

      allow write: if isOwner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp'
        ];

      allow delete: if isOwner(userId) || isAdmin();
    }

    // Nenhum outro arquivo é público ou gravável por padrão.
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
      allow delete: if false;
    }
  }
}
